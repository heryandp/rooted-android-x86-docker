# Redroid image built by install-vps.sh (Android 12 64only + MindTheGapps + libndk + Magisk)
REDROID_IMAGE=redroid/redroid:12.0.0_64only_mindthegapps_ndk_magisk

# Display & performance tuning (friendly for 2 vCPU / 4-8 GB RAM VPS)
REDROID_WIDTH=720
REDROID_HEIGHT=1280
REDROID_DPI=320
REDROID_FPS=24
REDROID_GPU_MODE=guest

# Memory caps to protect co-hosted services on the VPS
REDROID_MEM_LIMIT=2560m
REDROID_MEMSWAP_LIMIT=3584m
WS_SCRCPY_MEM_LIMIT=256m

# Persistent Android /data path
REDROID_DATA_DIR=/opt/redroid/data

# Network bindings (keep 127.0.0.1 for security; use Nginx Basic Auth or SSH tunnel)
ADB_BIND=127.0.0.1:5555
WS_SCRCPY_BIND=127.0.0.1:18000

# Web UI image
WS_SCRCPY_IMAGE=smanx/ws-scrcpy:latest
